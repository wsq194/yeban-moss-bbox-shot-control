{
  "YebanMossBBoxShotControlV1": {
    "display_name": "Yeban MOSS BBox 景别控制 V1",
    "inputs": {
      "image": {"name": "参考图"},
      "layout_aspect": {"name": "采样画幅比例"},
      "layout_long_edge": {"name": "采样长边（像素）", "tooltip": "默认 3072。宽高按 16 像素对齐；设为 0 时沿用原图尺寸。"},
      "shot_size": {"name": "景别", "options": {"reference": "沿用原图", "close": "近景", "environmental": "中景", "wide": "远景"}},
      "composition_position": {"name": "构图位置"},
      "backend": {"name": "后端", "options": {"local_grok": "本机 Grok CLI", "local_codex": "本机 Codex CLI", "dsh_official": "官方 DSH", "openai_compatible": "供应商 API"}},
      "backend_model": {"name": "模型"},
      "custom_model": {"name": "手填模型（可选）"},
      "reasoning": {"name": "推理强度", "options": {"default": "默认", "none": "关闭", "minimal": "最低", "low": "轻度", "medium": "中等", "high": "高度", "xhigh": "很高", "max": "最高"}},
      "subject_setting": {"name": "人物基础设定（可选）"},
      "photography_style": {"name": "摄影风格（可选）"},
      "additional_requirements": {"name": "附加提示词（可选，可留空）"},
      "timeout": {"name": "超时（秒）"},
      "use_cache": {"name": "使用缓存"},
      "cache_seed": {"name": "缓存种子"},
      "target_word_count": {"name": "智能反推目标英文词数"},
      "provider_config": {"name": "供应商配置（API 后端）", "tooltip": "仅使用供应商 API 时连接供应商管理器。"},
      "dsh_config": {"name": "DSH 配置（DSH 后端）", "tooltip": "仅使用官方 DSH 时连接官方 DSH 配置节点。"}
    },
    "outputs": {
      "0": {"name": "MOSS 布局提示词"},
      "1": {"name": "采样宽度"},
      "2": {"name": "采样高度"},
      "3": {"name": "智能反推提示词"}
    }
  },
  "YebanMossBBoxProviderManager": {
    "display_name": "夜半 MOSS BBox 供应商管理器",
    "inputs": {"供应商档案": {"name": "供应商档案（选择）"}, "启用供应商": {"name": "启用供应商"}},
    "outputs": {"0": {"name": "供应商配置"}, "1": {"name": "连接状态"}, "2": {"name": "供应商信息"}}
  },
  "YebanMossBBoxDshConfig": {
    "display_name": "夜半 MOSS BBox 官方 DSH 配置",
    "inputs": {"dsh_provider": {"name": "官方 DSH 供应商"}, "model": {"name": "官方 DSH 模型"}, "dsh_branch_session": {"name": "接续对话分支"}, "dsh_action": {"name": "使用方式"}},
    "outputs": {"0": {"name": "官方 DSH 配置"}}
  }
}
